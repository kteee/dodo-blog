// Cloudflare Workers 정적 사이트 배포 설정 (두두 투두와 같은 방식)
// - npm run build 결과(dist/)를 그대로 올림. 서버 코드는 없음 (SEO 프리렌더 Worker 는 2차)
// - 주소: dododiary.com 은 두두 홈(dodo-home) Worker 의 커스텀 도메인. 이 Worker 는 그 호스트의
//   `/@*`(블로그 홈·글)와 `/blog*`(앱 화면·에셋) 라우트로만 붙는다. Cloudflare 문서: "Routes … take precedence
//   if configured on the same hostname" — 라우트가 커스텀 도메인 Worker 보다 먼저 받는다
// - SPA 라서 /@아이디, /@아이디/글, /blog/edit/… 어디로 들어와도 index.html 을 돌려줌 (not_found_handling)
// - 에셋 경로는 /blog/assets/… (vite base) 라 홈의 /assets/… 와 안 겹침
{
  "name": "dodo-blog",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "dododiary.com/@*", "zone_name": "dododiary.com" },
    // Workers 에셋 계층이 /@아이디 를 /%40아이디 로 정규화 리다이렉트하므로 그 형태도 이 Worker 가 받아야 함 (앱이 %40 을 @ 로 풀어 읽음)
    { "pattern": "dododiary.com/%40*", "zone_name": "dododiary.com" },
    { "pattern": "dododiary.com/blog*", "zone_name": "dododiary.com" }
  ],
  "assets": {
    // dist/index.html(폴백) + dist/_headers + dist/blog/{index.html,assets,favicon.svg} — scripts/postbuild.mjs 참고
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // /blog ↔ /blog/ 트레일링 슬래시 리다이렉트 없이 그대로 (주소가 바뀌지 않게). 파일이 없으면 SPA 폴백
    "html_handling": "none"
  }
}
