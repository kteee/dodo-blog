// Cloudflare Workers 정적 사이트 배포 설정 (두두 투두와 같은 방식)
// - npm run build 결과(dist/)를 그대로 올림. 서버 코드는 없음 (SEO 프리렌더 Worker 는 2차)
// - SPA라서 없는 경로(/<아이디>/<글>, /edit/…, /my)로 들어와도 index.html을 돌려줌
{
  "name": "dodo-blog",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
